{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"ContextHub memory is available. Before substantial work, call ch_get_lessons to load error patterns, skill stats, and prompt effectiveness learned from prior sessions. When something is worth remembering across sessions (a failure and its fix, an approach that worked or did not), call ch_log_outcome so future sessions learn from it.\"}}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:contexthub:contexthub",
            "tool": "ch_get_governing",
            "input": {
              "format": "hook",
              "path": "${tool_input.file_path}"
            },
            "timeout": 3,
            "statusMessage": "Checking governing ADRs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "contexthub",
            "tool": "ch_log_outcome",
            "input": {
              "kind": "error",
              "summary": "Tool ${tool_name} failed",
              "details": {
                "category": "${tool_name}",
                "root_cause": "${tool_response}"
              }
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-concierge.sh\"",
            "timeout": 30,
            "async": true,
            "statusMessage": "Worktree concierge: auditing worktrees"
          }
        ]
      }
    ]
  }
}
